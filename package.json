{
  "name": "swift-browser",
  "version": "1.1.1",
  "description": "Swift Office Browser - Legacy Windows 7 compatible build",
  "main": "main.js",
  "scripts": {
    "start": "electron --tls-min-v1.0 --openssl-legacy-provider .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.office.swiftbrowser",
    "productName": "Swift Browser",
    "publish": [
      "github"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.1.8"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  }
}
